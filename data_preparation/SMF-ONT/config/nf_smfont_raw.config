includeConfig 'nf_smfont_bam.config'

// Add basecalling and modification calling to the shared extraction settings.
// Choose a compatible basecaller configuration and supply a trained model.
params {
    input_ext = 'pod5'
    basecall = true
    methyl = true
    basecaller = 'bonito'
    basecaller_cfg = 'dna_r10.4.1_e8.2_400bps_sup@v4.2.0'
    remora_cfg = 'custom'
    remora_model_path = null
    remora_args = null
}
