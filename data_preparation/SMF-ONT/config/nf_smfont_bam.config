// Convert aligned reads carrying modification tags to per-molecule calls.
// Supply input paths and a reference through command-line parameters.
params {
    input_folder = null
    sample_name = null
    input_ext = 'bam'
    ref = null
    outdir = 'output/ont'
    // Modification calls are already present in the input reads.
    basecall = false
    mapping = true
    methyl = false
    metBED = true
    metFreq = false
    readstats = false
    SMsorting = false
    coop = false
    nucl_reg = false
    modkit = false
    // Filter reads and modification calls before writing the output.
    qscore_filter = 7
    llr = 2.0
    motifs = 'cpg,gpc'
    filter_read_met_rate = true
    min_read_met_rate = 0.05
    max_read_met_rate = 0.95
    output_bam = true
    BSgenome = 'BSgenome.Mmusculus.UCSC.mm10'
    validate_params = false
}
